.page { min-height: 100vh; padding: 36rpx 30rpx 58rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 22rpx; }
.eyebrow { color: #667085; font-size: 24rpx; margin-bottom: 8rpx; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.reload { margin: 0; min-width: 116rpx; height: 60rpx; line-height: 60rpx; border-radius: 8rpx; background: #fff; color: #344054; border: 1rpx solid #e4e7ec; font-size: 24rpx; }
.range-row { display: flex; gap: 10rpx; margin-bottom: 22rpx; }
.range { flex: 1; min-width: 0; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0 12rpx; border-radius: 8rpx; background: #fff; color: #475467; border: 1rpx solid #e4e7ec; font-size: 24rpx; }
.range.active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
.stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-bottom: 24rpx; }
.stat { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 20rpx; min-height: 148rpx; box-sizing: border-box; }
.stat-label { color: #667085; font-size: 23rpx; }
.stat-value { color: #111827; font-size: 44rpx; font-weight: 700; line-height: 1.1; margin: 10rpx 0; }
.stat-note { color: #475467; font-size: 23rpx; line-height: 1.35; }
.section { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 22rpx; margin-bottom: 18rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.section-meta { flex: none; color: #667085; font-size: 23rpx; }
.bar-row { display: grid; grid-template-columns: 156rpx minmax(0, 1fr) 146rpx; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.bar-row:last-child { margin-bottom: 0; }
.bar-label, .bar-value { font-size: 24rpx; color: #344054; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar-value { text-align: right; color: #667085; }
.bar-track { height: 18rpx; background: #eef2f6; border-radius: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; }
.bar-fill.category { background: #1677ff; }
.bar-fill.expiry { background: #f79009; }
.trend-scroll { width: 100%; }
.trend { height: 260rpx; min-width: 940rpx; display: flex; align-items: flex-end; gap: 10rpx; padding-top: 10rpx; }
.trend-point { width: 54rpx; height: 236rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.stock-bar { width: 28rpx; min-height: 8rpx; background: #027a48; border-radius: 8rpx 8rpx 0 0; }
.trend-count { color: #344054; font-size: 20rpx; height: 34rpx; line-height: 34rpx; }
.trend-label { color: #98a2b3; font-size: 20rpx; height: 28rpx; line-height: 28rpx; white-space: nowrap; }
.trend.ops { height: 248rpx; }
.op-point { height: 224rpx; }
.op-bars { width: 42rpx; height: 150rpx; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; }
.op-bar { width: 16rpx; min-height: 8rpx; border-radius: 8rpx 8rpx 0 0; }
.op-bar.add, .dot.add { background: #1677ff; }
.op-bar.consume, .dot.consume { background: #d92d20; }
.legend { margin-top: 6rpx; color: #667085; font-size: 23rpx; }
.dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; margin: 0 8rpx 0 18rpx; vertical-align: middle; }
.dot:first-child { margin-left: 0; }
.value-section { border-left: 8rpx solid #475467; }
.value-message { color: #344054; font-size: 26rpx; line-height: 1.45; }
.value-meta { color: #667085; font-size: 23rpx; margin-top: 12rpx; }
.muted, .empty { color: #667085; font-size: 26rpx; padding: 30rpx 0; text-align: center; }
.empty.small { padding: 16rpx 0; font-size: 24rpx; }
.error-block { background: #fee4e2; color: #b42318; border-radius: 8rpx; padding: 18rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.error-detail { color: #7a271a; margin: 8rpx 0 14rpx; }
