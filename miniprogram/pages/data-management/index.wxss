.page { min-height: 100vh; padding: 32rpx 28rpx 56rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.header { margin-bottom: 26rpx; }
.title { font-size: 42rpx; font-weight: 700; }
.subtitle { color: #667085; font-size: 24rpx; margin-top: 8rpx; line-height: 1.5; }
.section { margin: 24rpx 0 32rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 14rpx; }
.action-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 14rpx; }
.action-row button { margin: 0; min-width: 132rpx; height: 62rpx; line-height: 62rpx; border-radius: 8rpx; font-size: 24rpx; }
.success { background: #16834a; color: #fff; }
.danger { background: #d92d20; color: #fff; }
.textarea { width: 100%; min-height: 220rpx; padding: 18rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; font-size: 24rpx; line-height: 1.5; color: #1f2933; }
.output { min-height: 180rpx; color: #475467; }
.file-name { font-size: 24rpx; color: #475467; margin-bottom: 10rpx; word-break: break-all; }
.result { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 16rpx; margin-top: 14rpx; color: #344054; font-size: 24rpx; line-height: 1.6; }
.error-block { background: #fee4e2; color: #b42318; border-radius: 8rpx; padding: 18rpx; margin: 20rpx 0; font-size: 26rpx; }
.error-line { color: #b42318; }
.muted { color: #667085; font-size: 26rpx; margin: 16rpx 0; }
.switch-line, .mapping-line, .field-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 0; font-size: 26rpx; }
.switch-line > view, .mapping-line > view { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.preview-title { margin-top: 24rpx; }
.table-region, .candidate-row { border-bottom: 1rpx solid #d0d5dd; padding: 18rpx 0; }
.field-line text { width: 170rpx; flex-shrink: 0; }
.field-line input { flex: 1; min-width: 0; border-bottom: 1rpx solid #d0d5dd; padding: 8rpx; background: #fff; }
.picker-value { padding: 10rpx; background: #eef2f6; }
.source-text { color: #667085; font-size: 24rpx; overflow-wrap: anywhere; }
.smart-entry-summary { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; padding: 18rpx; background: #fff; border: 1rpx solid #d0d5dd; border-radius: 8rpx; }
.smart-entry-summary > view { min-width: 0; flex: 1; }
.smart-entry-summary button { margin: 0; flex-shrink: 0; }
.smart-entry-title { font-size: 27rpx; font-weight: 700; }

.smart-overlay { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; background: rgba(15, 23, 42, 0.52); }
.smart-dialog { width: 100%; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; background: #fff; border-radius: 8rpx; box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.24); }
.smart-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 24rpx 18rpx; border-bottom: 1rpx solid #eaecf0; }
.smart-dialog-header > view { min-width: 0; }
.smart-dialog-title { font-size: 34rpx; line-height: 1.3; font-weight: 700; }
.smart-dialog-subtitle { margin-top: 6rpx; color: #667085; font-size: 22rpx; line-height: 1.45; }
.smart-close { width: 58rpx; min-width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #475467; font-size: 42rpx; line-height: 54rpx; }
.smart-close::after { border: 0; }

.smart-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1rpx solid #eaecf0; background: #f9fafb; }
.smart-step { min-width: 0; padding: 17rpx 8rpx 14rpx; border-bottom: 4rpx solid transparent; color: #667085; text-align: center; font-size: 22rpx; white-space: nowrap; }
.smart-step.active { border-bottom-color: #2563eb; color: #1d4ed8; font-weight: 700; }
.smart-dialog-body { flex: none; width: 100%; height: 60vh; box-sizing: border-box; padding: 22rpx 24rpx 32rpx; }
.smart-loading { margin-bottom: 18rpx; padding: 14rpx 16rpx; border-radius: 8rpx; background: #eff6ff; color: #1d4ed8; font-size: 24rpx; }
.smart-dialog-error { margin-bottom: 18rpx; padding: 14rpx 16rpx; border-radius: 8rpx; background: #fee4e2; color: #b42318; font-size: 24rpx; line-height: 1.5; }
.smart-intro { margin-bottom: 22rpx; padding: 18rpx; border-left: 6rpx solid #2563eb; background: #eff6ff; color: #475467; font-size: 24rpx; line-height: 1.55; }
.smart-intro-title { margin-bottom: 4rpx; color: #1f2933; font-size: 28rpx; font-weight: 700; }
.smart-required-note { margin-top: 10rpx; color: #344054; }
.smart-required-note text, .required-mark { color: #d92d20; font-weight: 700; }
.smart-intro-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.smart-intro-row > view { min-width: 0; flex: 1; }
.smart-intro-row button { margin: 0; flex-shrink: 0; }
.smart-group-title { margin: 24rpx 0 8rpx; color: #344054; font-size: 27rpx; font-weight: 700; }
.smart-found-summary { display: flex; align-items: center; gap: 18rpx; padding: 20rpx; border: 1rpx solid #bfdbfe; border-radius: 8rpx; background: #f8fbff; }
.smart-found-summary > text { flex-shrink: 0; color: #1d4ed8; font-size: 46rpx; line-height: 1; font-weight: 700; }
.smart-found-summary > view { min-width: 0; }
.smart-list-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eaecf0; }
.smart-list-content { min-width: 0; flex: 1; }
.smart-row-title { color: #1f2933; font-size: 27rpx; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; }
.smart-row-meta { margin-top: 5rpx; color: #667085; font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.smart-table { padding-bottom: 18rpx; border-bottom: 1rpx solid #d0d5dd; }
.smart-table .smart-list-row { border-bottom: 0; }
.smart-inventory-list { border-bottom: 1rpx solid #eaecf0; }
.smart-inventory-list .smart-list-row { border-bottom: 0; }
.smart-warning { margin: 10rpx 0; color: #b54708; font-size: 23rpx; line-height: 1.5; }
.smart-error { margin: 10rpx 0; color: #b42318; font-size: 23rpx; line-height: 1.5; }
.smart-warning-block { margin-top: 12rpx; padding: 16rpx; border-radius: 8rpx; background: #fff4e5; color: #b54708; font-size: 24rpx; line-height: 1.5; }
.smart-success-block { margin: 14rpx 0; padding: 16rpx; border-radius: 8rpx; background: #ecfdf3; color: #027a48; font-size: 24rpx; line-height: 1.5; }
.smart-advanced-toggle { margin: 20rpx 0 4rpx; padding: 0; border: 0; background: transparent; color: #2563eb; font-size: 24rpx; }
.smart-advanced-toggle::after { border: 0; }
.smart-advanced-panel { margin-top: 16rpx; padding: 18rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #f9fafb; }
.smart-text-button { margin: 6rpx 0 0; padding: 0 12rpx; border: 0; background: transparent; color: #2563eb; font-size: 23rpx; }
.smart-text-button::after { border: 0; }
.smart-advanced { margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #f9fafb; }
.smart-subtitle { margin: 8rpx 0 10rpx; color: #344054; font-size: 25rpx; font-weight: 700; }
.smart-range-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-bottom: 8rpx; }
.smart-range-field { min-width: 0; }
.smart-range-field text { display: block; margin-bottom: 6rpx; color: #667085; font-size: 22rpx; }
.smart-range-field input { width: 100%; box-sizing: border-box; padding: 12rpx; border: 1rpx solid #d0d5dd; border-radius: 6rpx; background: #fff; font-size: 24rpx; }

.candidate-row { padding: 22rpx 0; }
.smart-review-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 18rpx; }
.smart-review-summary > view { min-width: 0; padding: 18rpx 10rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; color: #667085; text-align: center; font-size: 22rpx; }
.smart-review-summary text { display: block; margin-bottom: 4rpx; color: #1f2933; font-size: 34rpx; font-weight: 700; }
.smart-review-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.smart-review-heading > view { min-width: 0; flex: 1; }
.smart-review-heading button { margin: 0; flex-shrink: 0; }
.smart-quick-fixes { margin: 20rpx 0; padding: 18rpx 0; border-top: 1rpx solid #d0d5dd; border-bottom: 1rpx solid #d0d5dd; }
.smart-fix-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #eaecf0; }
.smart-fix-row:last-child { border-bottom: 0; }
.smart-fix-row > view:first-child { min-width: 0; flex: 1; }
.smart-fix-title { color: #1f2933; font-size: 25rpx; line-height: 1.4; font-weight: 600; }
.smart-fix-row button { margin: 0; flex-shrink: 0; }
.smart-fix-row-stack { align-items: stretch; flex-direction: column; }
.smart-fix-actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.smart-fix-actions button { flex: 1; min-width: 220rpx; }
.candidate-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.candidate-heading > view:first-child { min-width: 0; flex: 1; }
.review-badge { flex-shrink: 0; padding: 6rpx 10rpx; border-radius: 6rpx; background: #fff4e5; color: #b54708; font-size: 21rpx; }
.review-badge.confirmed { background: #ecfdf3; color: #027a48; }
.review-badge.error { background: #fee4e2; color: #b42318; }
.review-badge.excluded { background: #eef2f6; color: #475467; }
.candidate-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 14rpx; }
.candidate-actions button { margin: 0; }
.candidate-flags { min-width: 0; display: flex; flex: 1; flex-wrap: wrap; justify-content: flex-end; gap: 10rpx 18rpx; }
.candidate-confirm { display: flex; align-items: center; gap: 10rpx; color: #475467; font-size: 23rpx; }
.candidate-editor { margin-top: 14rpx; padding: 12rpx 16rpx; border-radius: 8rpx; background: #f9fafb; }
.smart-add-button { margin: 18rpx 0 0; }

.smart-summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.smart-stat { min-width: 0; padding: 20rpx 8rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; text-align: center; color: #667085; font-size: 22rpx; }
.smart-stat text { display: block; margin-bottom: 5rpx; color: #1f2933; font-size: 36rpx; font-weight: 700; }
.smart-impact { padding: 18rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; color: #475467; font-size: 24rpx; line-height: 1.7; }
.smart-impact-title { margin-bottom: 6rpx; color: #1f2933; font-weight: 700; }
.smart-dialog-footer { display: flex; justify-content: flex-end; gap: 12rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eaecf0; background: #fff; }
.smart-dialog-footer button { min-width: 128rpx; height: 62rpx; margin: 0; border-radius: 8rpx; font-size: 24rpx; line-height: 62rpx; }
