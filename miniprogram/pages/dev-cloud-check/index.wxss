.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.title {
  color: #111111;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.run-button {
  margin-bottom: 32rpx;
}

.output {
  display: block;
  color: #222222;
  white-space: pre-wrap;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.6;
}
