.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.title {
  color: #111111;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.subtitle {
  color: #666666;
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.section-title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
}

.run-button {
  margin-bottom: 20rpx;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  color: #111111;
  font-size: 24rpx;
  box-sizing: border-box;
}

.output {
  display: block;
  color: #222222;
  white-space: pre-wrap;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}