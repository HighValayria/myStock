<view class="page">
  <view class="header">
    <view class="title">我的库存</view>
    <view class="subtitle">{{batchHint}}</view>
  </view>

  <view class="summary">
    <view class="summary-number">{{itemCount}}</view>
    <view class="summary-label">种物品</view>
  </view>

  <view class="actions">
    <button class="action add" bindtap="goAdd">+ 增加</button>
    <button class="action consume" bindtap="goConsume">- 消耗</button>
    <button class="action edit" bindtap="goEdit">✎ 编辑</button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{error}}" class="retry" bindtap="loadSummary">重新加载</button>
  <view wx:if="{{loading}}" class="muted">加载中...</view>

  <view class="section-title">最近使用</view>
  <view wx:if="{{!recentRows.length && !loading}}" class="empty">暂无最近使用物品</view>
  <view wx:for="{{recentRows}}" wx:key="id" class="recent-row">
    <view class="recent-name">{{item.name}}</view>
    <view class="recent-summary">{{item.summary}}</view>
  </view>
</view>
