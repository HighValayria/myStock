.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: #f7f7f4;
  color: #1f2933;
}

.header { margin-bottom: 28rpx; }
.title { font-size: 44rpx; font-weight: 700; margin-bottom: 8rpx; }
.subtitle, .muted, .empty, .recent-summary { color: #667085; font-size: 26rpx; }
.summary { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 32rpx; }
.summary-number { font-size: 64rpx; font-weight: 700; }
.summary-label { color: #475467; font-size: 26rpx; }
.actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 36rpx; width: 100%; }
.action { width: 100%; min-width: 0; height: 96rpx; line-height: 96rpx; margin: 0; padding: 0; box-sizing: border-box; border-radius: 8rpx; color: #ffffff; font-size: 28rpx; }
.add { background: #1677ff; }
.consume { background: #d92d20; }
.edit { background: #475467; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.recent-row { padding: 20rpx 0; border-bottom: 1rpx solid #e4e7ec; }
.recent-name { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.error { color: #b42318; background: #fee4e2; padding: 18rpx; border-radius: 8rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.retry { margin-bottom: 24rpx; font-size: 26rpx; }
