.page { min-height: 100vh; padding: 32rpx 28rpx 56rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; margin-bottom: 24rpx; }
.title { font-size: 42rpx; font-weight: 700; }
.subtitle { color: #667085; font-size: 24rpx; margin-top: 8rpx; }
.add-button { margin: 0; min-width: 128rpx; height: 64rpx; line-height: 64rpx; border-radius: 8rpx; background: #1677ff; color: #fff; font-size: 24rpx; }
.toolbar { margin-bottom: 22rpx; }
.search { height: 76rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 0 22rpx; box-sizing: border-box; font-size: 28rpx; margin-bottom: 14rpx; }
.filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.filter, .sort { height: 64rpx; line-height: 64rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 0 18rpx; box-sizing: border-box; color: #344054; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mode-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; }
.mode-row picker { flex: 1; min-width: 0; }
.segments { display: flex; gap: 8rpx; flex: none; }
.segment { margin: 0; min-width: 86rpx; height: 60rpx; line-height: 60rpx; padding: 0 14rpx; border-radius: 8rpx; background: #fff; color: #475467; font-size: 23rpx; }
.segment.active { background: #1f2933; color: #fff; }
.inventory-row { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 22rpx; margin-bottom: 14rpx; }
.row-main { display: flex; justify-content: space-between; gap: 16rpx; align-items: baseline; }
.item-title { min-width: 0; flex: 1; font-size: 30rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.spec { color: #667085; font-weight: 400; }
.quantity { color: #1d4ed8; font-size: 30rpx; font-weight: 700; flex: none; }
.meta { color: #667085; font-size: 25rpx; margin: 12rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.badges { display: flex; gap: 10rpx; flex-wrap: wrap; }
.badge { padding: 6rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; background: #eef2f6; color: #475467; }
.badge.warning { background: #fff4df; color: #b54708; }
.badge.danger { background: #fee4e2; color: #b42318; }
.badge.normal { background: #e7f8ef; color: #027a48; }
.table-scroll { width: 100%; }
.table { min-width: 1320rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; overflow: hidden; }
.tr { display: flex; min-height: 72rpx; border-bottom: 1rpx solid #eef2f6; }
.tr:last-child { border-bottom: none; }
.th { background: #f2f4f7; font-weight: 700; color: #344054; }
.td { flex: none; padding: 18rpx 14rpx; box-sizing: border-box; font-size: 24rpx; color: #344054; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.name-col { width: 220rpx; } .spec-col { width: 150rpx; } .qty-col { width: 120rpx; } .unit-col { width: 90rpx; } .loc-col { width: 220rpx; } .date-col { width: 150rpx; } .days-col { width: 120rpx; } .status-col { width: 125rpx; }
.muted, .empty { color: #667085; font-size: 26rpx; padding: 40rpx 0; text-align: center; }
.error-block { background: #fee4e2; color: #b42318; border-radius: 8rpx; padding: 18rpx; margin: 20rpx 0; font-size: 26rpx; }
.error-detail { color: #7a271a; margin: 8rpx 0 14rpx; }
