.page { min-height: 100vh; padding: 36rpx 30rpx 58rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.hero { margin-bottom: 22rpx; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.25; word-break: break-all; }
.subtitle { color: #667085; font-size: 28rpx; margin-top: 8rpx; }
.meta-line { color: #667085; font-size: 24rpx; margin-top: 12rpx; }
.summary-band { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 24rpx; margin-bottom: 18rpx; }
.summary-label { color: #667085; font-size: 24rpx; margin-bottom: 8rpx; }
.summary-value { color: #1d4ed8; font-size: 44rpx; font-weight: 700; }
.actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin: 22rpx 0 30rpx; }
.action { width: 100%; min-width: 0; height: 82rpx; line-height: 82rpx; margin: 0; padding: 0; border-radius: 8rpx; color: #fff; font-size: 27rpx; }
.add { background: #1677ff; } .consume { background: #d92d20; } .edit { background: #475467; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 30rpx 0 16rpx; }
.tx-title { margin-top: 36rpx; }
.batch-row, .tx-row { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx; }
.batch-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.batch-qty { font-size: 30rpx; font-weight: 700; }
.batch-meta { color: #667085; font-size: 25rpx; margin-top: 10rpx; line-height: 1.45; word-break: break-all; }
.badge { flex: none; padding: 6rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; background: #eef2f6; color: #475467; }
.badge.warning { background: #fff4df; color: #b54708; }
.badge.danger { background: #fee4e2; color: #b42318; }
.badge.normal { background: #e7f8ef; color: #027a48; }
.tx-main { display: grid; grid-template-columns: 150rpx 1fr auto; gap: 12rpx; align-items: center; color: #344054; font-size: 26rpx; }
.tx-qty { font-weight: 700; color: #1d4ed8; }
.tx-note { color: #667085; font-size: 24rpx; margin-top: 8rpx; }
.muted, .empty { color: #667085; font-size: 26rpx; padding: 36rpx 0; text-align: center; }
.error-block { background: #fee4e2; color: #b42318; border-radius: 8rpx; padding: 18rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.error-detail { color: #7a271a; margin: 8rpx 0 14rpx; }
