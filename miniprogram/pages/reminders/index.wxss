.page { min-height: 100vh; padding: 36rpx 30rpx 58rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; }
.eyebrow { color: #667085; font-size: 24rpx; margin-bottom: 8rpx; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.summary-pill { flex: none; padding: 10rpx 18rpx; border-radius: 8rpx; background: #fff; border: 1rpx solid #e4e7ec; color: #344054; font-size: 24rpx; }
.filter-row, .status-row { display: flex; gap: 10rpx; overflow-x: auto; padding-bottom: 12rpx; margin-bottom: 8rpx; white-space: nowrap; }
.filter, .status-filter { flex: none; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0 20rpx; border-radius: 8rpx; background: #fff; color: #475467; font-size: 24rpx; border: 1rpx solid #e4e7ec; }
.filter.active, .status-filter.active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 28rpx 0 16rpx; }
.restock-title { margin-top: 36rpx; }
.reminder-card, .restock-row { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx; }
.reminder-card.status-ACTIVE { border-left: 8rpx solid #d92d20; }
.reminder-card.status-READ { border-left: 8rpx solid #f79009; }
.reminder-card.status-DISMISSED { border-left: 8rpx solid #98a2b3; }
.reminder-card.status-RESOLVED { border-left: 8rpx solid #12b76a; }
.card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.card-title { min-width: 0; font-size: 30rpx; font-weight: 700; line-height: 1.35; word-break: break-all; }
.badge { flex: none; padding: 6rpx 12rpx; border-radius: 8rpx; background: #eef2f6; color: #475467; font-size: 22rpx; }
.card-meta { color: #667085; font-size: 25rpx; margin-top: 10rpx; line-height: 1.45; word-break: break-all; }
.card-actions { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 18rpx; }
.mini { margin: 0; height: 58rpx; line-height: 58rpx; padding: 0 20rpx; border-radius: 8rpx; font-size: 24rpx; }
.mini.primary { background: #1677ff; color: #fff; }
.mini.quiet { background: #eef2f6; color: #344054; }
.mini.danger { background: #d92d20; color: #fff; }
.mini.restock { background: #027a48; color: #fff; }
.restock-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.restock-name { font-size: 30rpx; font-weight: 700; line-height: 1.35; word-break: break-all; }
.restock-actions { flex: none; display: flex; gap: 10rpx; }
.muted, .empty { color: #667085; font-size: 26rpx; padding: 30rpx 0; text-align: center; }
.error-block { background: #fee4e2; color: #b42318; border-radius: 8rpx; padding: 18rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.error-detail { color: #7a271a; margin: 8rpx 0 14rpx; }
