.page { min-height: 100vh; padding: 56rpx 36rpx; box-sizing: border-box; background: #f7f7f2; color: #1f2933; }
.header { margin-bottom: 34rpx; }
.eyebrow { color: #667085; font-size: 24rpx; margin-bottom: 8rpx; }
.title { font-size: 42rpx; font-weight: 700; }
.section-title { font-size: 26rpx; color: #667085; margin: 24rpx 0 12rpx; }
.list { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 8rpx; overflow: hidden; }
.row { min-height: 108rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; box-sizing: border-box; }
.row-title { font-size: 30rpx; font-weight: 700; color: #1f2933; }
.row-meta { margin-top: 8rpx; font-size: 24rpx; color: #667085; }
.chevron { color: #98a2b3; font-size: 40rpx; line-height: 1; }
