<scroll-view class="page" scroll-y>
  <view class="title">增加库存</view>

  <view wx:if="{{isChooseMode}}" class="choice-panel">
    <button type="primary" bindtap="chooseNew">新增物品</button>
    <button class="secondary" bindtap="chooseExisting">已有物品</button>
  </view>

  <view wx:if="{{!isChooseMode}}" class="top-row">
    <button class="link" bindtap="backToChoose">返回选择</button>
  </view>

  <view wx:if="{{isExistingMode}}" class="section">
    <view class="section-title">选择已有物品</view>
    <input class="input" placeholder="搜索物品" value="{{search}}" bindinput="onSearchInput" />
    <view class="hint">最近使用会排在前面</view>
    <view wx:if="{{loading}}" class="hint">加载中...</view>
    <view wx:for="{{items}}" wx:key="id" class="item-row" data-id="{{item.id}}" bindtap="selectItem">
      <view class="item-name">{{item.name}}</view>
      <view class="item-summary">{{item.summary}}</view>
    </view>
    <view wx:if="{{emptyItems}}" class="empty">没有找到物品</view>
  </view>

  <view wx:if="{{showAddForm}}" class="section">
    <view class="section-title">基本信息</view>
    <view wx:if="{{isExistingMode}}" class="selected-name">已选择：{{selectedItemName}}</view>
    <input wx:if="{{isNewMode}}" class="input" placeholder="物品名称 *" data-field="name" value="{{form.name}}" bindinput="onFieldInput" />

    <view wx:if="{{isNewMode}}" class="field-label">类别</view>
    <picker wx:if="{{isNewMode}}" mode="selector" range="{{categoryNames}}" bindchange="onCategoryChange">
      <view class="select-box">{{selectedCategoryName}}</view>
    </picker>
    <view wx:if="{{showNewCategory}}" class="inline-create">
      <input class="input flex" placeholder="新类别名称" value="{{newCategoryName}}" bindinput="onNewCategoryInput" />
      <button size="mini" bindtap="createCategory">新建</button>
    </view>

    <input wx:if="{{isNewMode}}" class="input" placeholder="品牌（可选）" data-field="brand" value="{{form.brand}}" bindinput="onFieldInput" />
    <input wx:if="{{isNewMode}}" class="input" placeholder="规格（可选）" data-field="specification" value="{{form.specification}}" bindinput="onFieldInput" />
  </view>

  <view wx:if="{{showAddForm}}" class="section">
    <view class="section-title">库存信息</view>
    <view class="row">
      <input class="input flex" type="digit" placeholder="数量 *" data-field="quantity" value="{{form.quantity}}" bindinput="onFieldInput" />
      <picker mode="selector" range="{{commonUnits}}" bindchange="onUnitChange">
        <view class="unit-picker">{{form.unit}}</view>
      </picker>
    </view>
    <input wx:if="{{isNewMode}}" class="input" placeholder="单位，可自定义" data-field="unit" value="{{form.unit}}" bindinput="onFieldInput" />

    <view class="field-label">存放位置</view>
    <picker mode="selector" range="{{locationNames}}" bindchange="onLocationChange">
      <view class="select-box">{{selectedLocationName}}</view>
    </picker>
    <view wx:if="{{showNewLocation}}" class="inline-create">
      <input class="input flex" placeholder="新位置名称" value="{{newLocationName}}" bindinput="onNewLocationInput" />
      <button size="mini" bindtap="createLocation">新建</button>
    </view>
  </view>

  <view wx:if="{{showAddForm}}" class="section">
    <view class="section-title">日期与保质期</view>
    <view class="field-label">购买日期</view>
    <view class="date-row">
      <input class="input flex" placeholder="YYYY-MM-DD（可选）" data-field="purchaseDate" value="{{form.purchaseDate}}" bindinput="onFieldInput" />
      <picker mode="date" bindchange="onDatePickerChange" data-field="purchaseDate">
        <view class="date-button">日历</view>
      </picker>
    </view>

    <view class="field-label">生产日期</view>
    <view class="date-row">
      <input class="input flex" placeholder="YYYY-MM-DD（可选）" data-field="productionDate" value="{{form.productionDate}}" bindinput="onFieldInput" />
      <picker mode="date" bindchange="onDatePickerChange" data-field="productionDate">
        <view class="date-button">日历</view>
      </picker>
    </view>

    <view class="row">
      <input class="input flex" type="number" placeholder="保质期数值" data-field="shelfLifeValue" value="{{form.shelfLifeValue}}" bindinput="onFieldInput" />
      <picker mode="selector" range="{{shelfLifeUnitLabels}}" bindchange="onShelfLifeUnitChange">
        <view class="unit-picker">{{form.shelfLifeUnit}}</view>
      </picker>
    </view>
    <view class="expiry-preview">{{expectedExpiryText}}</view>
  </view>

  <view wx:if="{{showAddForm}}" class="section">
    <view class="more-header" bindtap="toggleMore">
      <view class="section-title">更多信息</view>
      <view class="more-toggle">{{showMoreLabel}}</view>
    </view>
    <view wx:if="{{showMore}}">
      <view class="field-label">直接填写到期日期</view>
      <view class="date-row">
        <input class="input flex" placeholder="YYYY-MM-DD" data-field="expiryDate" value="{{form.expiryDate}}" bindinput="onFieldInput" />
        <picker mode="date" bindchange="onDatePickerChange" data-field="expiryDate">
          <view class="date-button">日历</view>
        </picker>
      </view>
      <view class="hint">填写后将优先使用该到期日期。</view>
      <input class="input" type="digit" placeholder="单位购买价格（可选）" data-field="purchasePrice" value="{{form.purchasePrice}}" bindinput="onFieldInput" />
      <input class="input" placeholder="购买渠道（可选）" data-field="purchaseChannel" value="{{form.purchaseChannel}}" bindinput="onFieldInput" />
      <input wx:if="{{isNewMode}}" class="input" type="digit" placeholder="低库存阈值（高级设置）" data-field="lowStockThreshold" value="{{form.lowStockThreshold}}" bindinput="onFieldInput" />
      <input wx:if="{{isNewMode}}" class="input" type="number" placeholder="临期阈值天数（高级设置）" data-field="expiryWarningDays" value="{{form.expiryWarningDays}}" bindinput="onFieldInput" />
      <textarea class="textarea" placeholder="备注（可选）" data-field="note" value="{{form.note}}" bindinput="onFieldInput" />
    </view>
  </view>

  <button wx:if="{{showAddForm}}" type="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存增加</button>

  <view wx:if="{{result}}" class="success">{{result}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</scroll-view>
