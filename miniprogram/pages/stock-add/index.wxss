.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; background: #f7f7f4; color: #1f2933; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 28rpx; }
.choice-panel, .section { background: #ffffff; border-radius: 8rpx; padding: 24rpx; margin-bottom: 24rpx; }
.choice-panel button { margin-bottom: 20rpx; }
.secondary { background: #eef2f6; color: #1f2933; }
.top-row { margin-bottom: 20rpx; }
.link { background: transparent; color: #1677ff; padding: 0; text-align: left; font-size: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.field-label { font-size: 24rpx; color: #667085; margin: 18rpx 0 8rpx; }
.input, .textarea, .select-box, .unit-picker, .date-button { box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #ffffff; font-size: 28rpx; }
.input { height: 84rpx; padding: 0 20rpx; margin-bottom: 16rpx; }
.textarea { width: 100%; min-height: 140rpx; padding: 18rpx 20rpx; margin-bottom: 16rpx; }
.select-box { height: 84rpx; line-height: 84rpx; padding: 0 20rpx; margin-bottom: 16rpx; }
.row, .date-row, .inline-create { display: flex; gap: 16rpx; align-items: center; }
.flex { flex: 1; min-width: 0; }
.unit-picker, .date-button { min-width: 128rpx; height: 84rpx; line-height: 84rpx; text-align: center; margin-bottom: 16rpx; }
.item-row { padding: 20rpx 0; border-bottom: 1rpx solid #e4e7ec; }
.item-name, .selected-name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.item-summary, .hint, .empty { color: #667085; font-size: 24rpx; }
.expiry-preview { color: #1677ff; font-size: 26rpx; margin: 2rpx 0 12rpx; }
.more-header { display: flex; justify-content: space-between; align-items: center; }
.more-toggle { color: #1677ff; font-size: 26rpx; }
.success { color: #027a48; background: #dcfae6; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }
.error { color: #b42318; background: #fee4e2; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }