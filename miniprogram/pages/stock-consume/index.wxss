.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; background: #f7f7f4; color: #1f2933; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 28rpx; }
.section { background: #ffffff; border-radius: 8rpx; padding: 24rpx; margin-bottom: 24rpx; }
.emphasized { border: 2rpx solid #1677ff; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.section-label { font-size: 24rpx; color: #667085; margin: 18rpx 0 8rpx; }
.input, .textarea, .select-box { box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #ffffff; font-size: 28rpx; }
.input { height: 84rpx; padding: 0 20rpx; margin-bottom: 16rpx; }
.textarea { width: 100%; min-height: 130rpx; padding: 18rpx 20rpx; margin-bottom: 16rpx; }
.select-box { height: 84rpx; line-height: 84rpx; padding: 0 20rpx; }
.recent-strip { white-space: nowrap; margin-bottom: 10rpx; }
.recent-chip { display: inline-block; padding: 12rpx 22rpx; margin-right: 12rpx; border-radius: 999rpx; background: #eef2ff; color: #175cd3; font-size: 24rpx; }
.item-row { padding: 20rpx 0; border-bottom: 1rpx solid #e4e7ec; }
.item-name, .selected-name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.item-summary, .hint, .empty, .context { color: #667085; font-size: 24rpx; margin-bottom: 8rpx; }
.success { color: #027a48; background: #dcfae6; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }
.error { color: #b42318; background: #fee4e2; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }