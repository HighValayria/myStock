.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; background: #f7f7f4; color: #1f2933; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 24rpx; }
.input, .textarea { width: 100%; min-height: 76rpx; padding: 0 20rpx; margin-bottom: 18rpx; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #ffffff; box-sizing: border-box; font-size: 26rpx; }
.textarea { min-height: 140rpx; padding-top: 18rpx; }
.item-row { padding: 20rpx; margin-bottom: 14rpx; border: 1rpx solid #e4e7ec; border-radius: 8rpx; background: #ffffff; }
.selected { border-color: #d92d20; background: #fff1f3; }
.item-name, .selected-name { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }
.item-summary, .hint, .empty, .context { color: #667085; font-size: 24rpx; margin-bottom: 12rpx; }
.form { margin-top: 24rpx; }
.success { color: #067647; background: #dcfae6; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; }
.error { color: #b42318; background: #fee4e2; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; }