.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; background: #f7f7f4; color: #1f2933; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 28rpx; }
.section { background: #ffffff; border-radius: 8rpx; padding: 24rpx; margin-bottom: 24rpx; }
.emphasized { border: 2rpx solid #1677ff; background: #f8fbff; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.field-label { font-size: 24rpx; color: #475467; margin: 14rpx 0 8rpx; }
.input, .textarea, .select-box { box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 8rpx; background: #ffffff; font-size: 28rpx; }
.input { width: 100%; height: 84rpx; padding: 0 20rpx; margin-bottom: 14rpx; }
.textarea { width: 100%; min-height: 140rpx; padding: 18rpx 20rpx; margin-bottom: 18rpx; }
.select-box { min-height: 84rpx; line-height: 84rpx; padding: 0 20rpx; margin-bottom: 14rpx; color: #1f2933; }
.two-col { display: flex; gap: 16rpx; }
.col { flex: 1; min-width: 0; }
.inline-create { display: flex; gap: 14rpx; align-items: flex-start; margin-bottom: 12rpx; }
.flex { flex: 1; min-width: 0; }
.item-row, .batch-row { padding: 20rpx; margin-bottom: 14rpx; border: 1rpx solid #e4e7ec; border-radius: 8rpx; background: #ffffff; }
.selected { border-color: #1677ff; background: #eff8ff; }
.item-name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.item-summary, .hint, .empty, .context { color: #667085; font-size: 24rpx; margin-bottom: 10rpx; }
.row-actions { display: flex; gap: 16rpx; margin-top: 14rpx; }
.success { color: #027a48; background: #dcfae6; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }
.error { color: #b42318; background: #fee4e2; padding: 18rpx; border-radius: 8rpx; margin-top: 20rpx; font-size: 26rpx; }
button { border-radius: 8rpx; }
